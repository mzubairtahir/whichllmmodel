{
  "name": "whichllmmodel",
  "version": "1.0.1",
  "description": "Official open-source Hardware & Memory Profiler for whichllmmodel.com - Bridges local hardware into WhichLLM Local Finder",
  "type": "module",
  "main": "./bin/index.js",
  "bin": {
    "whichllmmodel": "./bin/index.js"
  },
  "files": [
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "start": "node ./bin/index.js"
  },
  "homepage": "https://www.whichllmmodel.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mzubairtahir/whichllmmodel.git"
  },
  "bugs": {
    "url": "https://github.com/mzubairtahir/whichllmmodel/issues"
  },
  "keywords": [
    "whichllmmodel",
    "llm",
    "ai",
    "local-llm",
    "vram",
    "gpu",
    "hardware",
    "memory",
    "profiler",
    "cli"
  ],
  "author": "WhichLLMModel Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4"
  }
}
