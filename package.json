{
  "name": "whichllmmodel",
  "version": "1.0.0",
  "description": "Official open-source CLI for whichllmmodel.com - Hardware-aware local LLM recommendation engine",
  "type": "module",
  "main": "./bin/index.js",
  "bin": {
    "whichllmmodel": "./bin/index.js",
    "wllm": "./bin/index.js",
    "wlm": "./bin/index.js"
  },
  "files": [
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "start": "node ./bin/index.js"
  },
  "homepage": "https://www.whichllmmodel.com",
  "keywords": [
    "whichllmmodel",
    "wllm",
    "llm",
    "ai",
    "local-llm",
    "vram",
    "gpu",
    "hardware",
    "recommendation",
    "ollama",
    "cli"
  ],
  "author": "WhichLLMModel Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ora": "^8.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4"
  }
}
