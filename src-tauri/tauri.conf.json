{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "whichllmmodel",
  "version": "1.0.0",
  "identifier": "com.whichllmmodel.simulator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "whichllmmodel",
        "width": 1180,
        "height": 840,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "bin/*"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  }
}

